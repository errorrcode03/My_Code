   "source": [
    "import numpy as np\n",
    "x=np.array([1,2,3])\n",
    "w=np.array([[0.5,0.5,0.6],[0.1,0.25,0.3],[0.26,0.55,0.65]])\n",
    "b=np.array([0.1,0.2,0.3])\n",
    "output=[]\n",
    "for i in range(len(b)):\n",
    "    value=np.dot(x,w[i].T)+b[i]\n",
    "    output.append(1/(1+np.exp(-value)))\n",
    "\n",
    "   \n",
    "print(np.array(output).round(3))"
   ]
  }
 ],
